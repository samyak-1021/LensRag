# ---- LensRAG backend configuration ----
# Copy to `.env` and adjust. Every value has a safe default, so the API boots
# with NO external services or API keys (using deterministic mock providers).

# App
LENSRAG_ENVIRONMENT=development
LENSRAG_CORS_ORIGINS=http://localhost:3000

# Database. Default is a local SQLite file (zero setup).
# Production example:
#   LENSRAG_DATABASE_URL=postgresql+asyncpg://lensrag:lensrag@db:5432/lensrag
LENSRAG_DATABASE_URL=sqlite+aiosqlite:///./lensrag.db

# Vector index backend: "memory" (numpy, no deps) or "pgvector" (needs Postgres).
LENSRAG_VECTOR_BACKEND=memory

# Text embeddings: "hash" (deterministic, no deps) or "bge" (real, needs [bge] extra).
LENSRAG_EMBEDDINGS_BACKEND=hash

# Answer generation: "mock" (deterministic, offline) or "gemini" (real VLM).
LENSRAG_LLM_PROVIDER=mock
# LENSRAG_GEMINI_API_KEY=your-key-here
LENSRAG_GEMINI_MODEL=gemini-2.0-flash

# Visual retrieval: "mock" (page-text proxy) or "colpali" (real, needs [colpali] extra + GPU).
LENSRAG_VISUAL_BACKEND=mock

# Retrieval / guard tuning
LENSRAG_RETRIEVAL_TOP_K=5
LENSRAG_GUARD_MIN_SCORE=0.25
